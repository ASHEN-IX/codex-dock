{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Dock",
  "version": "0.1.0",
  "identifier": "dev.ashenix.codex-dock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Dock",
        "width": 720,
        "height": 560,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "visible": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Multi-account usage dock for Codex",
    "longDescription": "Lists every Codex account, launches each in its own window on one shared chat store, and reports per-account usage from a tray gauge.",
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
