{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Dock",
  "version": "0.1.0",
  "identifier": "dev.ashenix.codex-dock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Dock",
        "width": 720,
        "height": 560,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-neutral.png",
      "iconAsTemplate": false
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/tray-green.png"
    ]
  }
}